{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/Ardelyo/trido/releases/latest/download/Trido-Setup-1.0.0.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|vendor/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
