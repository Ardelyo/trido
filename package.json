{
  "name": "trido",
  "private": false,
  "license": "MIT",
  "version": "1.0.0",
  "author": "Ardellio Satria Anindito",
  "copyright": "Copyright by Ardellio Satria Anindito",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "build:electron": "npm run build && node scripts/build-electron.js && electron-builder",
    "build:electron:win": "npm run build && node scripts/build-electron.js && electron-builder --win",
    "build:electron:mac": "npm run build && node scripts/build-electron.js && electron-builder --mac",
    "build:electron:linux": "npm run build && node scripts/build-electron.js && electron-builder --linux",
    "electron:dev": "node scripts/build-electron.js && electron .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=100000",
    "start": "tsx server.ts",
    "start:dev": "tsx server.ts",
    "lint:types": "tsc --noEmit",
    "format": "prettier --write \"design/**/*.ts\" \"utils/electron.ts\" \"types/**/*.ts\" \"electron/*.ts\""
  },
  "build": {
    "appId": "ai.trido.classroom",
    "productName": "Trido",
    "copyright": "Copyright by Ardellio Satria Anindito",
    "directories": {
      "output": "dist-release",
      "buildResources": "public"
    },
    "asar": false,
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**",
      "!node_modules/**/*.{md,map,ts,flow}",
      "!node_modules/.cache/**",
      "!node_modules/puppeteer*/**"
    ],
    "extraFiles": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trido",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/pwa-512x512.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/pwa-512x512.png",
      "category": "Education"
    }
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^1.34.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.8.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.17.2",
    "motion": "^12.38.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "perfect-freehand": "^1.2.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fabric": "^5.3.11",
    "@types/node": "^22.14.0",
    "@types/socket.io-client": "^1.4.36",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "puppeteer": "^25.5.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.1"
  }
}
