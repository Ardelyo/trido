# AI Mode: 'auto' | 'vertex' | 'gemini' | 'ollama'
AI_MODE=auto

# ── Google Cloud Project & Vertex AI (gemma4good-494311) ──────────────────────
# Vertex AI uses enterprise quota funded by the Google Cloud Project.
GOOGLE_CLOUD_PROJECT=gemma4good-494311
GOOGLE_CLOUD_LOCATION=global
VERTEX_PROJECT_ID=gemma4good-494311
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.7-flash

# Optional: For Vercel / serverless deployments without gcloud CLI,
# provide service account or ADC JSON string directly:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"authorized_user",...}

# ── Google Gemini (Direct Cloud) ─────────────────────────────────────────────
# Get a key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ── Ollama (Local / Offline) ─────────────────────────────────────────────────
# Install Ollama: https://ollama.ai
# Pull model: ollama pull gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_THINKING_MODE=nothink

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=3000
NODE_ENV=development

# ── Production deployment ─────────────────────────────────────────────────────
# Set ALLOWED_ORIGIN to your domain when deploying live.
# Example: ALLOWED_ORIGIN=https://trido.vercel.app
# ALLOWED_ORIGIN=https://your-domain.com

# ── Session persistence ───────────────────────────────────────────────────────
# ROOMS_FILE_PATH=/data/rooms_persistence.json
