# Mode AI: 'auto' | 'vertex' | 'gemini' | 'ollama'
AI_MODE=auto

# Proyek Google Cloud & Vertex AI (dipakai buat mode demo evaluasi)
GOOGLE_CLOUD_PROJECT=gemma4good-494311
GOOGLE_CLOUD_LOCATION=global
VERTEX_PROJECT_ID=gemma4good-494311
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash

# Opsional: buat deploy di Vercel/serverless tanpa gcloud CLI
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"authorized_user",...}

# Google Gemini Cloud (pakai API key pribadi dari https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Ollama Lokal (100% gratis & offline)
# Buat laptop RAM 4GB-8GB bisa ganti OLLAMA_MODEL=trido-gemma:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=trido-model:latest
OLLAMA_THINKING_MODE=nothink

# Opsional: webhook Google Sheets buat log telemetri
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# Port server lokal (default 3000 di web/CLI, 3030 di dalam aplikasi desktop .exe)
SERVER_PORT=3000
NODE_ENV=development

# Setel ALLOWED_ORIGIN kalau di-deploy ke domain publik
# ALLOWED_ORIGIN=https://trido.vercel.app

# Lokasi file penyimpanan room Socket.IO
# ROOMS_FILE_PATH=/data/rooms_persistence.json
